# Required
API_KEY=                          # generate: openssl rand -hex 32
DATABASE_PATH=./data/apidb.db

# HTTP server
HOSTNAME=127.0.0.1
PORT=5001

# CORS — comma-separated list of allowed origins, or * for all
CORS_ORIGINS=*

# Security
SECURE_HEADERS=true

# Logging
LOGGER_LEVEL=info
LOGGER_PRETTY_PRINT=false

# Whisper
WHISPER_MODEL=large-v3            # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cuda               # cuda | cpu
BEAM_SIZE=5

# Download
MAX_FILE_SIZE_MB=500
DOWNLOAD_TIMEOUT_SECONDS=120

# S3 / MinIO — leave S3_ENDPOINT_URL blank for AWS, set for MinIO
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
