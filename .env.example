# Required
API_KEY=                          # generate: openssl rand -hex 32
DATABASE_PATH=./data/apidb.db

# HTTP server
HOSTNAME=127.0.0.1
PORT=5001

# CORS — comma-separated list of allowed origins, or * for all
CORS_ORIGINS=*

# Security
SECURE_HEADERS=true

# Logging
LOGGER_LEVEL=info
LOGGER_PRETTY_PRINT=true
