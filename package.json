{
    "name": "whisperqueue-api",
    "version": "0.1.0",
    "description": "Async GPU-accelerated transcription microservice — Bun, Hono, SQLite, faster-whisper",
    "keywords": [
        "transcription",
        "whisper",
        "faster-whisper",
        "gpu",
        "bun",
        "hono",
        "sqlite",
        "self-hosted",
        "async",
        "docker"
    ],
    "homepage": "https://github.com/WhisperQueue/whisperqueue-api#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/WhisperQueue/whisperqueue-api.git"
    },
    "bugs": {
        "url": "https://github.com/WhisperQueue/whisperqueue-api/issues"
    },
    "license": "MIT",
    "author": "WhisperQueue Contributors",
    "private": true,
    "type": "module",
    "module": "src/index.ts",
    "engines": {
        "bun": ">=1.2.0"
    },
    "scripts": {
        "prepare": "lefthook install",
        "dev": "bun --watch src/index.ts",
        "start": "bun src/index.ts",
        "check:types": "tsc --noEmit",
        "check:code": "fallow",
        "check:dupes": "fallow dupes",
        "check:health": "fallow health",
        "check:dead-code": "fallow dead-code",
        "check": "bun run check:types && bun run check:code",
        "lint": "biome check .",
        "lint:fix": "biome check --fix .",
        "test": "bun test",
        "db:generate": "drizzle-kit generate --config src/db/drizzle.config.ts",
        "db:migrate": "drizzle-kit migrate --config src/db/drizzle.config.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1048.0",
        "bunqueue": "^2.7.14",
        "drizzle-orm": "^0.45.2",
        "hono": "^4.12.19"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.15",
        "@commitlint/cli": "^21.0.1",
        "@commitlint/config-conventional": "^21.0.1",
        "@types/bun": "^1.3.14",
        "better-sqlite3": "^12.10.0",
        "drizzle-kit": "^0.31.10",
        "fallow": "^2.75.0",
        "lefthook": "^2.1.6",
        "typescript": "^6.0.3"
    }
}
