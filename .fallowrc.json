{
    "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
    "entry": ["src/index.{ts,tsx,js,jsx}", "src/main.{ts,tsx,js,jsx}", "src/scripts/*.{ts,tsx}", "test/**/*.test.{ts,tsx}"],
    "ignoreDependencies": ["better-sqlite3", "bunqueue"],
    "ignoreExports": [
        { "file": "src/services/transcriptCache.ts", "exports": ["getTranscriptCacheService"] },
        { "file": "src/services/downloader.ts", "exports": ["getDownloaderService"] },
        { "file": "src/services/transcriber.ts", "exports": ["getTranscriberService"] }
    ],
    "duplicates": {
        "minOccurrences": 2
    },
    "rules": {}
}
